#!/bin/bash
# Pre-commit secret scan (dependency-free; replace with gitleaks if preferred).
# Blocks commits containing likely real credentials while allowlisting the
# intentional dev-only placeholders used in this repo.
set -u

ALLOW='CHANGE_ME|changeme-dev-only|minioadmin|minioadmin123|testuser|localhost|placeholder|example|override|YOUR_|<[^>]+>'

# Scan staged content (not worktree) for yml/yaml/js/json/properties/env files.
STAGED=$(git diff --cached --name-only --diff-filter=ACM | grep -Ei '\.(ya?ml|js|json|properties|env|txt)$' || true)
[ -z "$STAGED" ] && exit 0

PATTERN='sk_(test|live)_[A-Za-z0-9]+|sk-or-v1-[A-Za-z0-9-]+|whsec_[A-Za-z0-9]+|github_pat_[A-Za-z0-9_]+|ghu_[A-Za-z0-9]+|xox[bap]-|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|"password"\s*:\s*"[^"$][^"]+"|password:\s*["'"'"']?[A-Za-z0-9@#$%^&*!]{12,}'

FAIL=0
for f in $STAGED; do
  # shellcheck disable=SC2086
  HITS=$(git show ":$f" 2>/dev/null | grep -nEi "$PATTERN" | grep -viE "$ALLOW" || true)
  if [ -n "$HITS" ]; then
    echo "secret-scan BLOCKED: possible credential in staged file '$f':"
    echo "$HITS" | head -10
    FAIL=1
  fi
done

if [ "$FAIL" -ne 0 ]; then
  echo "If a hit is a false positive, use an allowlisted placeholder (CHANGE_ME / changeme-dev-only)."
  exit 1
fi
exit 0
